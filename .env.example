# TrueForge Agent Environment Configuration
# Copy this file to .env and configure values for your environment.

# Secret key for HMAC-SHA256 Approval Gate token signing (provide a random 64-char hex string in production)
TRUEFORGE_SECRET_KEY=replace_with_a_secure_random_64_character_hex_key

# Server Port and Host
PORT=8000
HOST=127.0.0.1

# Allowed CORS Origins (comma-separated list, or * for local development)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional LLM API Keys (if running with external provider harnesses)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
